# ───────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored; this template is committed so others know what's needed.
# ───────────────────────────────────────────────────────────────────────────

# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Backend admin endpoints (sent as the X-Admin-Api-Key header)
ADMIN_API_KEY=change-me

# Service URLs. SCRAPER_URL / BACKEND_URL are in-Docker addresses (service name
# + port). FRONTEND_URL is the public base URL of the site (used for SEO/sitemap).
SCRAPER_URL=http://scrape:5001
BACKEND_URL=http://backend:8080
FRONTEND_URL=http://localhost:3000
