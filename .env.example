# ───────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored; this template is committed so others know what's needed.
# ───────────────────────────────────────────────────────────────────────────

# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# pgAdmin (http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Backend admin endpoints (sent as the X-Admin-Api-Key header)
ADMIN_API_KEY=change-me

# Brevo SMTP (transactional email) — https://app.brevo.com → SMTP & API
BREVO_SMTP_LOGIN=your-login@smtp-brevo.com
BREVO_SMTP_KEY=your-brevo-smtp-key
# "From" address — must be a Brevo-verified sender, or sends are rejected.
MAIL_FROM=no-reply@example.com

# Service URLs. SCRAPER_URL / BACKEND_URL are in-Docker addresses (service name
# + port). FRONTEND_URL is the public URL used in confirmation/reset email links.
SCRAPER_URL=http://scrape:5001
BACKEND_URL=http://backend:8080
FRONTEND_URL=http://localhost:3000
