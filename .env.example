# ───────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored; this template is committed so others know what's needed.
# ───────────────────────────────────────────────────────────────────────────

# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Backend admin endpoints (sent as the X-Admin-Api-Key header)
ADMIN_API_KEY=change-me

# Backend market tuning (optional; defaults shown). Seed price is in sub-units
# (1 coin = 100), so 1250 = 12.50 coins. These apply to fighters listed after
# the change, not ones already seeded. Snapshots-per-hour: 1 = hourly, 2 = every
# 30 min, 4 = every 15 min.
FIGHTER_SEED_PRICE=1250
FIGHTER_SEED_SHARES=1000
PORTFOLIO_SNAPSHOTS_PER_HOUR=1

# Salary (optional; defaults shown). Amount is in sub-units (50000 = 500 coins).
# Interval is in days: 1 = daily, 2 = every other day, 14 = every two weeks.
# Always paid at 06:00 UTC; the profile's "next payout" reflects this.
SALARY_AMOUNT=50000
SALARY_INTERVAL_DAYS=14

# Service URLs. SCRAPER_URL / BACKEND_URL are in-Docker addresses (service name
# + port). FRONTEND_URL is the public base URL of the site (used for SEO/sitemap,
# and as the allowed origin for the /ws WebSocket — see WS_ALLOWED_ORIGINS in
# docker-compose.yml).
SCRAPER_URL=http://scrape:5001
BACKEND_URL=http://backend:8080
FRONTEND_URL=http://localhost:3000

# AI trading agents (the `agents` service). The agents reuse ADMIN_API_KEY above
# to provision their bot accounts. GEMINI_API_KEY powers their strategy; if left
# blank the agents still run on a deterministic heuristic fallback (handy locally).
# RUN_WITH_AI=0 turns the agents off entirely; 1 (default) runs them.
RUN_WITH_AI=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# TRADE_RATE is the single knob for how lively the market is. 1.0 is the
# baseline; lower = fewer, smaller, slower trades; higher = more orders per tick,
# bigger size, harder price pushes, and faster ticks (the charts move a lot more).
# Clamped to 0.1–8.0. Default 1.5.
TRADE_RATE=1.5
# Optional tuning (defaults shown): how often agents act vs. how often Gemini
# re-strategizes, how many fighters they concentrate on, and base order size.
# AGENT_TICK_SECONDS=30
# STRATEGY_REFRESH_SECONDS=240
# MAX_FIGHTERS=20
# BASE_QTY=14
